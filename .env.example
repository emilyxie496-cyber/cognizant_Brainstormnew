# Copy to .env and fill in what you have. Everything is optional: with an empty
# file Waymark still runs, using labelled demo and estimate-only fallbacks.
# .env is git-ignored. Never commit real keys.

# --- Server only (never exposed to the browser) ---
CLIMATIQ_API_KEY=
# Optional. Enables plain-language recommendation explanations.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Powers Delay Assist (reading supplier emails, drafting messages) and
# the AI Trade Analyst. Any OpenAI-compatible endpoint works. There are no
# default model names: choose one your provider offers today.
# Without these, both features still work using rules and templates.
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Tried when the first provider fails or its quota runs out.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# AI calls allowed per account per day (and for all anonymous visitors together).
AI_DAILY_LIMIT=200

# Optional. Reserved for a container or air waybill tracking adapter.
TRACKING_PROVIDER=
TRACKING_API_KEY=

API_PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
UPSTREAM_TIMEOUT_MS=10000
# Shared daily Climatiq allowance for anonymous demo visitors.
DEMO_CLIMATIQ_DAILY=300

# --- Supabase (optional; enables real accounts) ---
# VITE_ values are bundled into the browser. The anon key is designed to be
# public and is safe only with row-level security, which the migration enables.
# Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Browser (public) ---
# Where the front end finds the API. Leave empty when the Node server serves the
# site (same origin, /api). For a static host such as Lovable, point this at the
# Supabase Edge Function or a separately hosted Node API, for example:
#   VITE_API_BASE=https://<project-ref>.supabase.co/functions/v1/waymark-api
VITE_API_BASE=

# --- Waymark 3.0 Express platform (server only) ---
# The Edge Function does not implement the new platform routes. Use Express.
APP_BASE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173
WAYMARK_DATA_DIR=.waymark-data
# Set a long random secret before storing credentials; keep it stable across restarts.
INTEGRATIONS_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Development mock hosts only. Keep empty in production.
EXTRA_ALLOWED_HOSTS=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
ANTHROPIC_EFFORT=medium
ANTHROPIC_BASE_URL=
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_MS=120000
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_MINOR_VERSION=75
QUICKBOOKS_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
QUICKBOOKS_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
QUICKBOOKS_REVOKE_URL=https://developer.api.intuit.com/v2/oauth2/tokens/revoke
QUICKBOOKS_API_BASE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=
SHOPIFY_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_API_BASE_URL=https://slack.com/api
SLACK_AUTH_URL=https://slack.com/oauth/v2/authorize
OPEN_METEO_API_KEY=
MARINETRAFFIC_BASE_URL=https://services.marinetraffic.com/api
PROJECT44_BASE_URL=https://na12.api.project44.com
# One persistent Node instance only; 0 disables server scheduling.
MONITOR_INTERVAL_MINUTES=0

# Existing upstream overrides, useful for local mock services.
CLIMATIQ_BASE_URL=https://api.climatiq.io
OPENSKY_BASE_URL=https://opensky-network.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
GEOCODE_BASE_URL=https://geocoding-api.open-meteo.com
FX_BASE_URL=https://www.bankofcanada.ca
DIRECTORY_BASE_URL=https://www.wikidata.org
NEWS_BASE_URL=https://news.google.com
GDELT_BASE_URL=https://api.gdeltproject.org
